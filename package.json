{
  "name": "blockout-guide",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build && node --experimental-strip-types scripts/prerender.ts && node --experimental-strip-types scripts/verify-build.ts",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:e2e": "node tests/e2e/server.mjs",
    "typecheck": "tsc --noEmit",
    "check:comments": "node scripts/check-comments.mjs",
    "validate:content": "node --experimental-strip-types scripts/validate-content.ts",
    "validate:templates": "node --experimental-strip-types scripts/validate-templates.ts",
    "validate:i18n": "node scripts/check-i18n-parity.mjs",
    "sync:playlist": "node --experimental-strip-types scripts/sync-playlist.ts",
    "generate:levels": "node --experimental-strip-types scripts/generate-levels.ts",
    "generate:levels:151-500": "node --experimental-strip-types scripts/generate-levels-151-500.ts",
    "enrich:levels:151-500": "node --experimental-strip-types scripts/enrich-levels-151-500.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run",
    "test:worker": "node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test": "npm run validate:templates && npm run validate:content && npm run test:unit && npm run build && npm run test:worker",
    "quality": "npm run format:check && npm run check:comments && npm run typecheck && npm run lint && npm run validate:i18n && npm run test && npm run test:e2e",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "preview": "vinext start"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.47.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "^4.1.10",
    "wrangler": "4.114.0"
  },
  "type": "module"
}
